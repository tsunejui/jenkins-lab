# https://editorconfig.org
# Root of the project — stops editor lookup here.
root = true

# ── Defaults ─────────────────────────────────────────────────────────────────
[*]
charset                  = utf-8
end_of_line              = lf
insert_final_newline     = true
trim_trailing_whitespace = true
indent_style             = space
indent_size              = 4

# ── Structured data (2 spaces, common convention) ────────────────────────────
[*.{yml,yaml,json,toml}]
indent_size = 2

# ── Markdown (keep trailing whitespace for hard line-breaks) ─────────────────
[*.md]
trim_trailing_whitespace = false

# ── Makefiles require literal tabs for recipe lines ──────────────────────────
[Makefile]
indent_style = tab
